# tryACOwork - environment variables
#
# Copy to .env.local for local development, and set the same values in the
# hosting provider for Production and Preview. Server-only secrets must NOT be
# prefixed NEXT_PUBLIC_ - anything with that prefix is shipped to the browser.
#
# The site runs without any of these. Nothing crashes when a key is missing;
# the feature that needs it degrades honestly instead:
#   - no RESEND_API_KEY   -> forms still succeed, emails are logged server-side
#   - no NEXT_PUBLIC_GA_ID -> analytics never loads, and no events fire
#   - no NEXT_PUBLIC_CAL_LINK -> the booking page shows an email fallback
#   - no LEAD_WEBHOOK_URL -> submissions are logged rather than stored
#   - no GitHub OAuth     -> /admin cannot sign in

# --- Site ------------------------------------------------------------------
# The canonical host, used for canonical tags, Open Graph URLs and the sitemap.
# Spec 9.2: pick www or non-www once and redirect the other. This is www.
NEXT_PUBLIC_SITE_URL=https://www.tryacowork.com

# --- Staging only ----------------------------------------------------------
# Set BOTH of these on the staging deployment, and NEITHER on production.
#
# NEXT_PUBLIC_STAGING makes robots.txt disallow everything, so nothing is
# crawled or indexed.
# NEXT_PUBLIC_STAGING=true
#
# STAGING_PASSWORD puts the whole site behind an HTTP Basic prompt (see
# src/middleware.ts). Any username works; the password is this value. Leaving it
# unset - which production does - makes the protection inert, so it can never
# accidentally lock the live site.
# STAGING_PASSWORD=choose-something-and-send-it-with-the-link

# --- Booking (Cal.com) -----------------------------------------------------
# In the form "username/event", e.g. tryacowork/20min.
# The Cal.com event MUST be configured with a success redirect to
#   https://www.tryacowork.com/thank-you-call
# because that page load is what fires call_booked, the primary conversion.
# This overrides the value in content/settings.json, so staging can point at a
# test event without a commit.
NEXT_PUBLIC_CAL_LINK=

# Optional: a plain URL shown as "open the calendar in a new tab" if the embed
# cannot load at all.
# NEXT_PUBLIC_BOOKING_FALLBACK_URL=

# --- Email (Resend) --------------------------------------------------------
# Required for the two forms to actually send. Before launch, SPF, DKIM and
# DMARC must be set on the sending domain or the autoresponders land in spam.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@tryacowork.com
CONTACT_TO_EMAIL=hello@tryacowork.com

# Optional: a Slack incoming webhook, pinged on a new pilot request.
# SLACK_WEBHOOK_URL=

# --- Storing submissions ---------------------------------------------------
# Spec 8.4: email alone loses data when someone deletes a message. Point this
# at a Google Sheet via Apps Script, or at Zapier/Make. A sheet is perfectly
# adequate at this stage.
LEAD_WEBHOOK_URL=

# Or a CRM, if one is adopted later. Used only if LEAD_WEBHOOK_URL is unset.
# HUBSPOT_PORTAL_ID=
# HUBSPOT_FORM_GUID=

# --- Analytics -------------------------------------------------------------
# GA4 measurement id. The placeholder G-XXXXXXX is ignored on purpose, so a
# misconfigured environment cannot start collecting silently. Analytics does
# not load at all until the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=G-XXXXXXX

# --- The editor at /admin --------------------------------------------------
# A GitHub OAuth App (Settings > Developer settings > OAuth Apps):
#   Homepage URL:               https://www.tryacowork.com
#   Authorization callback URL: https://www.tryacowork.com/api/admin/callback
# Scope defaults to `repo`, which is what a private repository needs. For a
# public repository, set GITHUB_OAUTH_SCOPE=public_repo instead - narrower is
# better, because this token can write to the repository.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPE=repo
